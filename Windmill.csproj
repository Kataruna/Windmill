<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Windmill</AssemblyName>
    <RootNamespace>Windmill</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Window.ThemeMode (Fluent theme) is experimental in .NET 9.
         WFO0003 wants DPI awareness set from WinForms code instead, but this is a WPF app that needs it in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

</Project>
