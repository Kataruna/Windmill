<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish -p:PublishProfile=dist  ->  dist\Windmill.exe, one self-contained file. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs go inside the exe too, so dist stays a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed on purpose: a compressed bundle is unpacked into private memory at startup,
         which doubled Windmill's idle memory (about 240 MB vs 113 MB). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>dist\</PublishDir>
  </PropertyGroup>
</Project>
